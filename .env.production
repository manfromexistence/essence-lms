APP_NAME="Dhaka IT Institute"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
PRIVATE_FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
ALLOW_DATABASE_RESTORE=false

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379 
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS Configuration
SMS_DRIVER=mock
SMS_MOCK_DELIVERY_DELAY=2
SMS_MOCK_FAILURE_RATE=10
SMS_MOCK_LOGGING=true
SMS_MOCK_SIMULATE_STATUS=true
SMS_MAX_LENGTH=160
SMS_BULK_BATCH_SIZE=100
SMS_BULK_BATCH_DELAY=1
SMS_RETRY_MAX_ATTEMPTS=3
SMS_RETRY_DELAY=5

# Institution Information
INSTITUTION_NAME="Dhaka IT Institute"
INSTITUTION_ADDRESS="House #5 (2nd floor), Road #8, Block-C, Section-10, Mirpur-10, Dhaka-1216"
INSTITUTION_PHONE="+8801682715576"
INSTITUTION_EMAIL="dhakaitinstitute@gmail.com"
INSTITUTION_WEBSITE="https://dhakaitinstitute.com"
INSTITUTION_LOGO="/logo.png"
INSTITUTION_BKASH=""
INSTITUTION_NAGAD=""
