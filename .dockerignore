# Never bake local storage symlinks/uploads into the image — the entrypoint
# creates public/storage -> storage/app/public at boot, and uploads must live
# on the runtime filesystem, not in the image layers.
public/storage
storage/app/public/*
!storage/app/public/.gitignore
