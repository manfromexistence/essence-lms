APP_NAME="Dhaka IT Institute"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
BKASH_ADMIN_NUMBER=
BKASH_ACCOUNT_NAME="Dhaka IT Institute"
NAGAD_ADMIN_NUMBER=
ROCKET_ADMIN_NUMBER=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Media host.
#
# Images, course video, exam screenshots and payment proofs are hosted on Catbox
# rather than on this server's disk, because a shared host cannot carry lecture
# video at a workable size.
#
# Two consequences, both deliberate:
#   * Every hosted object is world-readable. A URL that leaks stays public.
#   * Files cannot be deleted. Removing a record only stops the portal pointing
#     at the object; the remote copy stays. Supplying CATBOX_USERHASH (a Catbox
#     account key) is what would enable real deletion.
FILESYSTEM_DISK=catbox
PRIVATE_FILESYSTEM_DISK=catbox

CATBOX_API_URL=https://catbox.moe/user/api.php
CATBOX_BASE_URL=https://files.catbox.moe
# Leave empty to upload anonymously. Set to a Catbox account key to enable deletes.
CATBOX_USERHASH=
CATBOX_USER_AGENT=Laravel-LMS
CATBOX_TIMEOUT=300
CATBOX_CONNECT_TIMEOUT=15
CATBOX_READ_TIMEOUT=300

# Largest single upload the host accepts (Catbox's ceiling is 200 MB). Validating
# against our own larger limit would only move the failure to after the transfer.
MEDIA_MAX_UPLOAD_KB=204800

# S3 remains available as an alternative media host. To use it, set both disks
# above to `s3` and fill these in. Note the trade-off is inverted: objects can be
# deleted, but they are only as private as the bucket's policy.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

QUEUE_CONNECTION=database
ALLOW_DATABASE_RESTORE=false

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=


VITE_APP_NAME="${APP_NAME}"

# SMS Configuration
SMS_DRIVER=mock
SMS_MOCK_DELIVERY_DELAY=2
SMS_MOCK_FAILURE_RATE=10
SMS_MOCK_LOGGING=true
SMS_MOCK_SIMULATE_STATUS=true
SMS_MAX_LENGTH=160
SMS_BULK_BATCH_SIZE=100
SMS_BULK_BATCH_DELAY=1
SMS_RETRY_MAX_ATTEMPTS=3
SMS_RETRY_DELAY=5

# Institution Information
INSTITUTION_NAME="Dhaka IT Institute"
INSTITUTION_ADDRESS="House #5 (2nd floor), Road #8, Block-C, Section-10, Mirpur-10, Dhaka-1216"
INSTITUTION_PHONE="+880 1682-715570"
INSTITUTION_EMAIL="dhakaitinstitute@gmail.com"
INSTITUTION_WEBSITE="https://dhakaitinstitute.com"
INSTITUTION_LOGO="/logo.png"
INSTITUTION_BKASH=""
INSTITUTION_NAGAD=""

# Optional support/verification accounts (all-or-nothing per role, 16+ char
# passwords — unset means the account is NOT created, even in production)
# DEFAULT_SUPER_ADMIN_EMAIL=
# DEFAULT_SUPER_ADMIN_PASSWORD=
# DEFAULT_ADMIN_EMAIL=
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_TEACHER_EMAIL=
# DEFAULT_TEACHER_PASSWORD=
# DEFAULT_STUDENT_EMAIL=
# DEFAULT_STUDENT_PASSWORD=
# DEFAULT_PARENT_EMAIL=
# DEFAULT_PARENT_PASSWORD=

# Upload content scanning (optional ClamAV antivirus daemon)
UPLOAD_SCAN_ENABLED=true
CLAMAV_HOST=
CLAMAV_PORT=3310

